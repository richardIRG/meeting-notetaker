# Copy to ~/.config/meeting-notetaker/.env and fill in. Then: chmod 600 ~/.config/meeting-notetaker/.env
# Variables already set in your environment take precedence over this file.

# Required: ElevenLabs API key with speech-to-text access
ELEVENLABS_API_KEY=

# Required for notes (skip if notes.enabled = false)
OPENAI_API_KEY=

# Optional: Telegram notifications (also set [telegram] enabled = true)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional overrides
# NOTETAKER_CONFIG=~/.config/meeting-notetaker/config.toml
# NOTETAKER_OUTPUT_DIR=~/Meetings
